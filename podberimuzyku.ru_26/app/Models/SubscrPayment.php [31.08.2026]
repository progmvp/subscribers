<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Model;

class SubscrPayment extends Model
{
    protected $table = 'subscr_payments';

    protected $connection = 'mysql';

    protected $fillable = [
        'user_id',
        'subscription_id',
        'plan_id',
        'payment_id',
        'amount',
        'status',
        'paid_at',
    ];

    protected $casts = [
        'amount' => 'decimal:2',
        'paid_at' => 'datetime',
    ];
}