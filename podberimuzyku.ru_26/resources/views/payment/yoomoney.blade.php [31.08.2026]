<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Оплата — {{ $planName }}</title>
</head>
<body>

<div style="max-width:500px;margin:60px auto;padding:30px;border:1px solid #ddd;border-radius:12px;font-family:Arial,sans-serif;">

    <h2>Оплата подписки</h2>

    <p><strong>{{ $name }}</strong></p>
    <p>{{ $email }}</p>

    <hr>

    <p>Тариф: <strong>{{ $planName }}</strong></p>
    <p>Сумма: <strong>{{ $amount }} ₽</strong></p>

    <form method="POST" action="https://yoomoney.ru/quickpay/confirm">

        <input type="hidden"
               name="receiver"
               value="{{ $yoomoneyReceiver }}">

        <input type="hidden"
               name="quickpay-form"
               value="button">

        <input type="hidden"
               name="paymentType"
               value="AC">

        <input type="hidden"
               name="sum"
               value="{{ number_format($amount, 2, '.', '') }}">

        <input type="hidden"
               name="label"
               value="{{ $paymentId }}">

        <input type="hidden"
               name="successURL"
               value="https://ebpp.podberimuzyku.ru/pay?name={{ urlencode($name) }}&email={{ urlencode($email) }}&plan={{ urlencode($plan) }}">

        <button type="submit"
                style="padding:14px 28px;font-size:18px;cursor:pointer;">
            Оплатить {{ $amount }} ₽
        </button>

    </form>

</div>

</body>
</html>
